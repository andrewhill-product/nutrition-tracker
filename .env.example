# Anthropic API key used for all meal analysis and calibration distillation.
ANTHROPIC_API_KEY=sk-ant-...

# Pooled Postgres connection string (Neon via the Vercel Marketplace).
# Used by the app at runtime.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# IMPORTANT: direct (unpooled) connection string for schema pushes.
# `npm run db:push` runs DDL, which breaks through PgBouncer-style poolers.
# Neon on Vercel exposes this as DATABASE_URL_UNPOOLED or POSTGRES_URL_NON_POOLING.
# If neither is set, db:push falls back to DATABASE_URL with a warning.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Vercel Blob read-write token (created with the Blob store).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# The single shared password for the app.
APP_PASSWORD=choose-a-long-password
